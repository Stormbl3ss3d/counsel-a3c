# Dockerfile.t113 -- counsel-a3c on torch 1.13.1 (the authors' likely torch generation).
# Under torch < 2.0, optimizer.zero_grad() zeroes grads IN PLACE; traina3c.py shares the
# same grad tensor between local and global models, so local grads are cleared too and the
# gradient-accumulation bug (bug 3) does not occur. Bugs 1, 2, 4-7 are NOT affected.
#
# Package set validated together in a Python 3.10.22 venv (2026-11-02): unpatched upstream
# load server + traina3c.py ran 4 episodes and saved a checkpoint. The image (CPU-only torch
# wheel instead of the CUDA one) was then built on the Victus on 2026-11-02 as counsel:t113,
# image id 2fa7ed7e051d, and used for runs t113-fix4-f5-c3 and t113-fix5-f5-c3.
#
# Build:  docker build -f Dockerfile.t113 -t counsel:t113 .
FROM python:3.10-slim

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONUNBUFFERED=1

# CPU-only wheel (~200 MB) instead of the PyPI one that bundles CUDA 11.7 (~2 GB).
# Same version; COUNSEL runs on CPU anyway.
# --extra-index-url (not --index-url): torch's "+cpu" build only exists on the PyTorch index,
# while its dependency typing-extensions must come from PyPI (the PyTorch index copy has bad
# metadata and its sdist needs flit_core, which that index does not host).
RUN pip install --extra-index-url https://download.pytorch.org/whl/cpu "torch==1.13.1+cpu"

RUN pip install \
      "numpy==1.23.5" \
      "gym==0.26.2" \
      "networkx==2.8.6" \
      "scipy==1.10.1" \
      "requests==2.28.2" \
      "fastapi==0.87.0" \
      "uvicorn==0.20.0" \
      "pydantic==1.10.27" \
      "psycopg2-binary==2.9.5" \
      "joblib==1.2.0" \
      "psutil==5.9.3" \
      "tqdm==4.64.1"

# Code is bind-mounted at /counsel at run time (same as counsel:local), so edits need no rebuild.
WORKDIR /counsel
